# Copy to .env. Never commit this file after filling it in.
OKX_API_KEY=
OKX_API_SECRET=
OKX_PASSPHRASE=
OKX_BASE_URL=https://www.okx.com
# Public wallet address only. Never supply a wallet private key or seed.
HL_ADDRESS=
HL_BASE_URL=https://api.hyperliquid.xyz
# Required before remote access. Use at least 16 characters.
DASHBOARD_PASSWORD=
COOKIE_SECURE=false
DATA_DIR=./data
CONFIG_PATH=./config/strategy.yaml
POLL_SECONDS=3
ENABLE_PUBLIC_WS=true
# Bark: fill a device key and enable explicitly. Critical bypass needs iOS permission.
BARK_ENABLED=false
BARK_SERVER=https://api.day.app
BARK_DEVICE_KEY=
BARK_CRITICAL=false
BARK_VOLUME=5
# Optional alternative notification destination, disabled by default.
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
